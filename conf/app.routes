# microservice specific routes

GET         /change-of-details-request/:arn                     uk.gov.hmrc.agentservicesaccount.controllers.ChangeOfDetailsRequestController.find(arn: String)
POST        /change-of-details-request                          uk.gov.hmrc.agentservicesaccount.controllers.ChangeOfDetailsRequestController.upsert()
DELETE      /change-of-details-request/:arn                     uk.gov.hmrc.agentservicesaccount.controllers.ChangeOfDetailsRequestController.delete(arn: String)

GET         /agent-record-with-checks/arn/:arn                  uk.gov.hmrc.agentservicesaccount.controllers.AgentDetailsController.clientGetWithChecks(arn:Arn)
GET         /agent-record-with-checks                           uk.gov.hmrc.agentservicesaccount.controllers.AgentDetailsController.agentGetWithChecks()
POST        /agent/agency-details/arn/:arn                      uk.gov.hmrc.agentservicesaccount.controllers.AgentDetailsController.post(arn: Arn)
POST        /dms-agent-callback                                 uk.gov.hmrc.agentservicesaccount.controllers.DmsNotificationController.dmsCallback()
